{
  "name": "familywinner",
  "productName": "FamilyWinner",
  "version": "1.0.0",
  "description": "Asistente para el juego de las familias: sugiere qué carta pedir y detecta trampas.",
  "author": "Futurehouser",
  "license": "MIT",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Futurehouser/FamilyWinner.git"
  },
  "scripts": {
    "sync": "node scripts/sync.js",
    "icons": "python scripts/make_icon.py",
    "start": "npm run sync && electron .",
    "test": "node scripts/test-logic.js",
    "build:win": "npm run sync && electron-builder --win portable",
    "build:android": "npm run sync && npx cap sync android && cd android && gradlew.bat assembleRelease",
    "build": "npm run build:win && npm run build:android && node scripts/collect.js"
  },
  "build": {
    "appId": "com.futurehouser.familywinner",
    "productName": "FamilyWinner",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "www/**",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "FamilyWinner-Portable.exe"
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
